{
  "additionalProperties": false,
  "properties": {
    "claim_version_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Claim Version Ids",
      "type": "array"
    },
    "comparison_id": {
      "title": "Comparison Id",
      "type": "string"
    },
    "conflict_type": {
      "enum": [
        "no_conflict",
        "complementary",
        "scope_difference",
        "temporal_change",
        "factual_contradiction",
        "opinion_difference",
        "uncertain"
      ],
      "title": "Conflict Type",
      "type": "string"
    },
    "contract_hash": {
      "title": "Contract Hash",
      "type": "string"
    },
    "disposition": {
      "anyOf": [
        {
          "enum": [
            "resolved_by_scope",
            "resolved_by_correction",
            "resolved_by_reproduction",
            "weighted_conclusion",
            "unresolved_disclosed",
            "requires_user_judgment"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disposition"
    },
    "evidence_version_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Evidence Version Ids",
      "type": "array"
    },
    "input_manifest_hash": {
      "title": "Input Manifest Hash",
      "type": "string"
    },
    "next_investigation": {
      "default": "",
      "title": "Next Investigation",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "requirement_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Requirement Ids",
      "type": "array"
    },
    "review_version_id": {
      "title": "Review Version Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "severity": {
      "default": "blocking",
      "enum": [
        "blocking",
        "material"
      ],
      "title": "Severity",
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "investigating",
        "resolved",
        "unresolved",
        "dismissed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "claim_version_ids",
    "evidence_version_ids",
    "requirement_ids",
    "conflict_type",
    "status",
    "input_manifest_hash",
    "contract_hash",
    "comparison_id",
    "review_version_id",
    "reason"
  ],
  "title": "ConflictCase",
  "type": "object"
}
