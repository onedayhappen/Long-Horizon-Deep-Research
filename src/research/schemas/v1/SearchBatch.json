{
  "$defs": {
    "SearchHit": {
      "additionalProperties": false,
      "properties": {
        "hit_id": {
          "title": "Hit Id",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "rank": {
          "minimum": 0,
          "title": "Rank",
          "type": "integer"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "hit_id",
        "url",
        "title",
        "snippet",
        "rank"
      ],
      "title": "SearchHit",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "default": "unknown",
          "enum": [
            "provider",
            "reserved_upper_bound",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "cost": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "provider_details": {
          "additionalProperties": true,
          "title": "Provider Details",
          "type": "object"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "hits": {
      "items": {
        "$ref": "#/$defs/SearchHit"
      },
      "title": "Hits",
      "type": "array"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "hit",
        "empty",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
  },
  "required": [
    "query_id",
    "hits",
    "status"
  ],
  "title": "SearchBatch",
  "type": "object"
}
