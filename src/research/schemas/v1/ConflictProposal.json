{
  "$defs": {
    "ClaimFrame": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "items": {
            "$ref": "#/$defs/EvidenceBasis"
          },
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        },
        "claim_version_id": {
          "title": "Claim Version Id",
          "type": "string"
        },
        "conditions": {
          "items": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "array"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "subject": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject"
        },
        "time": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "claim_version_id",
        "basis"
      ],
      "title": "ClaimFrame",
      "type": "object"
    },
    "EvidenceBasis": {
      "additionalProperties": false,
      "properties": {
        "evidence_version_id": {
          "title": "Evidence Version Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_version_id",
        "quote"
      ],
      "title": "EvidenceBasis",
      "type": "object"
    },
    "EvidenceRelationAudit": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/EvidenceBasis"
        },
        "claim_version_id": {
          "title": "Claim Version Id",
          "type": "string"
        },
        "evidence_version_id": {
          "title": "Evidence Version Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "refutes",
            "contextualizes",
            "uncertain"
          ],
          "title": "Relation",
          "type": "string"
        },
        "scope_match": {
          "title": "Scope Match",
          "type": "boolean"
        }
      },
      "required": [
        "claim_version_id",
        "evidence_version_id",
        "relation",
        "scope_match",
        "basis",
        "reason"
      ],
      "title": "EvidenceRelationAudit",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conflict_type": {
      "enum": [
        "no_conflict",
        "complementary",
        "scope_difference",
        "temporal_change",
        "factual_contradiction",
        "opinion_difference",
        "uncertain"
      ],
      "title": "Conflict Type",
      "type": "string"
    },
    "disposition": {
      "anyOf": [
        {
          "enum": [
            "resolved_by_scope",
            "resolved_by_correction",
            "resolved_by_reproduction",
            "weighted_conclusion",
            "unresolved_disclosed",
            "requires_user_judgment"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disposition"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/ClaimFrame"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Frames",
      "type": "array"
    },
    "next_investigation": {
      "default": "",
      "title": "Next Investigation",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/EvidenceRelationAudit"
      },
      "title": "Relations",
      "type": "array"
    }
  },
  "required": [
    "conflict_type",
    "frames",
    "reason"
  ],
  "title": "ConflictProposal",
  "type": "object"
}
