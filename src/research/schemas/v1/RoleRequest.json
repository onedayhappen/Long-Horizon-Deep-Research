{
  "$defs": {
    "RoleImage": {
      "additionalProperties": false,
      "properties": {
        "blob_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Blob Hash",
          "type": "string"
        },
        "data_base64": {
          "title": "Data Base64",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "media_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Media Type",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "blob_hash",
        "data_base64",
        "width",
        "height"
      ],
      "title": "RoleImage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "exclusiveMinimum": 0,
      "title": "Contract Version",
      "type": "integer"
    },
    "data_packet": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "title": "Data Packet",
      "type": "object"
    },
    "images": {
      "items": {
        "$ref": "#/$defs/RoleImage"
      },
      "title": "Images",
      "type": "array"
    },
    "input_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Manifest Hash",
      "type": "string"
    },
    "logical_action_key": {
      "title": "Logical Action Key",
      "type": "string"
    },
    "max_output_tokens": {
      "exclusiveMinimum": 0,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "policy_version": {
      "exclusiveMinimum": 0,
      "title": "Policy Version",
      "type": "integer"
    },
    "response_schema_id": {
      "title": "Response Schema Id",
      "type": "string"
    },
    "response_schema_version": {
      "exclusiveMinimum": 0,
      "title": "Response Schema Version",
      "type": "integer"
    },
    "role": {
      "enum": [
        "planner.initialize",
        "auditor.question_space",
        "planner.next",
        "researcher.extract",
        "auditor.evidence",
        "auditor.counter_entailment",
        "auditor.provenance",
        "auditor.conflict",
        "auditor.coverage",
        "auditor.search_bias",
        "writer.section",
        "auditor.report",
        "planner.reuse_map",
        "researcher.inspect_figures",
        "researcher.read_figure",
        "auditor.visual",
        "auditor.visual_counter",
        "vision.probe",
        "researcher.select_sources",
        "auditor.gap",
        "auditor.outline"
      ],
      "title": "Role",
      "type": "string"
    },
    "system_template_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "System Template Hash",
      "type": "string"
    },
    "system_template_id": {
      "title": "System Template Id",
      "type": "string"
    }
  },
  "required": [
    "role",
    "logical_action_key",
    "input_manifest_hash",
    "contract_version",
    "policy_version",
    "system_template_id",
    "system_template_hash",
    "data_packet",
    "response_schema_id",
    "response_schema_version",
    "max_output_tokens"
  ],
  "title": "RoleRequest",
  "type": "object"
}
